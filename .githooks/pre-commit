#!/bin/sh
echo "Compiling..."
pixi run mojo build -I src examples/sketch.mojo -o /tmp/mojo-create-precommit-check 2>&1
status=$?
rm -f /tmp/mojo-create-precommit-check
if [ $status -ne 0 ]; then
    echo "Compilation failed — commit aborted."
    exit 1
fi

echo "Running tests..."
pixi run bash -c 'set -e; for f in tests/test_*.mojo; do mojo run -I src "$f"; done' 2>&1
if [ $? -ne 0 ]; then
    echo "Tests failed — commit aborted."
    exit 1
fi

exit 0
